{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch tModLoader",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:TMOD_DIR}/dotnet/dotnet",
            "args": [
                "${env:TMOD_DIR}/tModLoader.dll"
            ],
            "cwd": "${env:TMOD_DIR}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "LD_LIBRARY_PATH": "${env:TMOD_DIR}/lib64:${env:TMOD_DIR}/lib:${env:TMOD_DIR}/dotnet/shared/Microsoft.NETCore.App/8.0.0",
                "STEAM_RUNTIME": "1",
                "DOTNET_ROOT": "${env:TMOD_DIR}/dotnet",
                "COMPlus_ZapDisable": "1"
            },
            "justMyCode": false,
            "requireExactSource": false,
            "suppressJITOptimizations": true,
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/bin/Debug/net8.0"
                ]
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": false,
            "requireExactSource": false,
            "suppressJITOptimizations": true,
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/bin/Debug/net8.0"
                ]
            }
        }
    ]
}
